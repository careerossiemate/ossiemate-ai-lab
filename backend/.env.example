# Application configuration
APP_NAME="Ossiemate AI Lab"
APP_VERSION=0.1.0
ENVIRONMENT=development

# Microsoft Foundry
AZURE_OPENAI_ENDPOINT=https://ai103-agent-lab.openai.azure.com/openai/v1
MODEL_DEPLOYMENT=gpt-5-mini-2
ADVANCED_MODEL_DEPLOYMENT=gpt-5.2
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-small
FOUNDRY_PROJECT_ENDPOINT=

# AI execution configuration
MAX_PROMPT_CHARACTERS=8000
MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT=120
AI_MAX_RETRIES=0
MAX_CONCURRENT_REQUESTS=3

# AI feature controls
STORE_AI_RESPONSES=true
TOKEN_MONITORING_ENABLED=true
EXECUTION_METRICS_ENABLED=true
FINE_TUNING_ENABLED=false

# Managed Identity
AZURE_CLIENT_ID=

# Azure Storage
STORAGE_ACCOUNT_NAME=stossiemateailab

# Blob containers
BROCHURES_CONTAINER=brochures
TRAINING_CONTAINER=training-data
RESULTS_CONTAINER=demonstration-results
CONFIG_CONTAINER=lab-config
BACKUPS_CONTAINER=backups

# Storage tables
PROGRESS_TABLE=ExerciseProgress
CONVERSATION_TABLE=ConversationHistory
METRICS_TABLE=ExecutionMetrics
CONFIGURATION_TABLE=LabConfiguration
TRAINING_JOBS_TABLE=TrainingJobs

# Frontend configuration
FRONTEND_ORIGIN=https://mango-sea-0589cd400.6.azurestaticapps.net

# Microsoft Entra ID authentication
AZURE_TENANT_ID=
API_CLIENT_ID=
SPA_CLIENT_ID=
ALLOWED_USER_IDS=
API_SCOPE=access_as_user